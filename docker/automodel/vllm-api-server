#!/bin/bash
# Start the vLLM OpenAI server (`vllm serve`) from /opt/vllm-env with the NGC
# vLLM image's environment. Arguments go to `vllm serve` unchanged.
# --check imports vllm with that environment, then exits.
set -euo pipefail
VE=/opt/vllm-env
SP=$VE/lib/python3.12/site-packages
CUDA=/usr/local/cuda-13.4
HPCX=/opt/vllm-hpcx
export LD_LIBRARY_PATH=$HPCX/ucx/lib:/opt/ffmpeg-safe/lib:$SP/torch/lib:/opt/ffmpeg-safe-cv2-shim-v5/lib:/opt/ffmpeg-safe-cv2-shim-v8/lib:/opt/vllm-syslib:$CUDA/targets/x86_64-linux/lib:$HPCX/ucc/lib:$HPCX/ompi/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64
export PATH=$VE/bin:/opt/ffmpeg-safe/bin:$CUDA/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export CUDA_HOME=$CUDA
export TRITON_PTXAS_PATH=$CUDA/bin/ptxas
export TRITON_CUOBJDUMP_PATH=$CUDA/bin/cuobjdump
export TRITON_NVDISASM_PATH=$CUDA/bin/nvdisasm
export TRITON_CUPTI_PATH=$CUDA/include
export TRITON_CUDACRT_PATH=$CUDA/include
export TRITON_CUDART_PATH=$CUDA/include
export VLLM_ALLOW_RUNTIME_LORA_UPDATING=1
# the training env's variables must not reach this interpreter
unset VIRTUAL_ENV PYTHONPATH PYTHONHOME
if [ "${1:-}" = --check ]; then
  exec "$VE/bin/python" -c 'import torch, vllm, vllm.entrypoints.cli.main; print("vllm", vllm.__version__, "torch", torch.__version__)'
fi
# CUDA forward compat, as the NGC images' /etc/shinit_v2 does for their own
# toolkit: use the 13.4 compat driver only when it initialises on this host's
# kernel driver; a host driver new enough for 13.4 does not need it.
COMPAT=$CUDA/compat/lib.real
if [ "$(LD_LIBRARY_PATH=$COMPAT LD_PRELOAD= timeout -s KILL 35 /usr/local/bin/cudaCheck 2>/dev/null)" = "CUDA Driver OK" ]; then
  export LD_LIBRARY_PATH=$COMPAT:$LD_LIBRARY_PATH
  echo "vllm-api-server: CUDA forward compat on ($COMPAT)" >&2
else
  echo "vllm-api-server: CUDA forward compat off, using the host driver" >&2
fi
exec "$VE/bin/python" -m vllm.entrypoints.cli.main serve "$@"
